rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function getZoneData(zoneId) {
      return get(/databases/$(database)/documents/zones/$(zoneId)).data;
    }

    function isZoneCreator(zoneId) {
      let zoneDoc = get(/databases/$(database)/documents/zones/$(zoneId));
      return request.auth != null && (
        request.auth.uid == zoneDoc.data.tutorId || 
        request.auth.uid == zoneDoc.data.createdBy
      );
    }

    function isCoTutor(zoneId) {
      let zoneDoc = get(/databases/$(database)/documents/zones/$(zoneId));
      return request.auth != null && request.auth.uid in zoneDoc.data.coTutorRoles;
    }

    function isCoTutorForSubject(zoneId, subject) {
      let zoneDoc = get(/databases/$(database)/documents/zones/$(zoneId));
      return request.auth != null && 
             request.auth.uid in zoneDoc.data.coTutorRoles && 
             (zoneDoc.data.coTutorRoles[request.auth.uid] == subject || subject == 'Multiple' || subject == 'All' || subject == 'multiple' || subject == 'all');
    }

    function isZoneStudent(zoneId) {
      return exists(/databases/$(database)/documents/zones/$(zoneId)/students/$(request.auth.uid));
    }

    function getStudentBatchId(zoneId) {
      let studentDoc = get(/databases/$(database)/documents/zones/$(zoneId)/students/$(request.auth.uid));
      return studentDoc.data.get('batchId', null);
    }

    // --- ZONES Collection ---
    // Zones — authenticated users can read zone metadata (for Discovery/Explore)
    match /zones/{zoneId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        (resource.data.createdBy == request.auth.uid || resource.data.tutorId == request.auth.uid) ||
        (
           // Allow co-tutors to remove themselves
           'coTutorRoles' in resource.data &&
           request.auth.uid in resource.data.coTutorRoles &&
           !(request.auth.uid in request.resource.data.get('coTutorRoles', {}))
        )
      ) && (
        !('coTutors' in request.resource.data) || request.resource.data.coTutors.size() <= 7
      );
      allow delete: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.tutorId == request.auth.uid
      );
    }

    // --- ZONES SUB-COLLECTIONS (Hardened Paths) ---

    // ZONES/STUDENTS
    match /zones/{zoneId}/students/{studentId} {
      allow read: if isSignedIn() && (
        isZoneCreator(zoneId) ||
        (isZoneStudent(zoneId) && (
          studentId == request.auth.uid ||
          resource.data.get('batchId', null) == getStudentBatchId(zoneId)
        ))
      );
      allow write: if request.auth != null && (
        studentId == request.auth.uid ||
        isZoneCreator(zoneId)
      );
    }

    match /zones/{zoneId}/segments/{segmentId} {
      allow read: if request.auth != null && (
        isZoneCreator(zoneId) ||
        exists(/databases/$(database)/documents/zones/$(zoneId)/students/$(request.auth.uid))
      );
      allow write: if isZoneCreator(zoneId);
    }

    // ZONES/CHAPTERS (Priority Fix)
    match /zones/{zoneId}/chapters/{chapterId} {
      // Broad read for authenticated users to avoid snapshot listener failures
      allow read: if isSignedIn(); 
      // Only creators can manage curriculum
      allow write: if isSignedIn() && isZoneCreator(zoneId);
    }

    // ZONES/VIDEOS
    match /zones/{zoneId}/videos/{videoId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isZoneCreator(zoneId);
    }

    // ZONES/EXAMS
    match /zones/{zoneId}/exams/{examId} {
      allow read: if isSignedIn() && (
        exists(/databases/$(database)/documents/zones/$(zoneId)/students/$(request.auth.uid)) ||
        isZoneCreator(zoneId) ||
        isCoTutorForSubject(zoneId, resource.data.subject)
      );
      allow write: if isSignedIn() && isZoneCreator(zoneId);

      match /submissions/{studentId} {
        allow read: if isSignedIn() && (
          request.auth.uid == studentId || 
          isZoneCreator(zoneId) ||
          isCoTutorForSubject(zoneId, get(/databases/$(database)/documents/zones/$(zoneId)/exams/$(examId)).data.subject)
        );
        allow write: if false;
      }
    }

    // ZONES/ORDERS
    match /zones/{zoneId}/orders/{orderId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.studentUid || isZoneCreator(zoneId));
      allow write: if false;
    }

    // ZONES/INVITES
    match /zones/{zoneId}/invites/{inviteId} {
      allow read, write: if isSignedIn() && isZoneCreator(zoneId);
    }

    // ZONES/SESSIONS & ATTENDANCE
    match /zones/{zoneId}/sessions/{sessionId} {
      allow read: if isSignedIn() && (
        isZoneCreator(zoneId) ||
        (isZoneStudent(zoneId) && (
          resource.data.get('batchId', null) == null ||
          resource.data.get('batchId', null) == getStudentBatchId(zoneId)
        ))
      );
      allow write: if isSignedIn() && isZoneCreator(zoneId);
      
      match /attendance/{attendeeId} {
        allow read, write: if isSignedIn() && isZoneCreator(zoneId);
      }
    }

    // ZONES/LIVESESSIONS
    match /zones/{zoneId}/liveSessions/{sessionId} {
      allow read: if isSignedIn() && (isZoneCreator(zoneId) || isZoneStudent(zoneId));
      allow write: if isSignedIn() && isZoneCreator(zoneId);

      match /messages/{messageId} {
        allow read: if isSignedIn() && (isZoneCreator(zoneId) || isZoneStudent(zoneId));
        allow write: if isSignedIn() && (isZoneCreator(zoneId) || isZoneStudent(zoneId));
      }

      match /raisedHands/{studentId} {
        allow read: if isSignedIn() && (isZoneCreator(zoneId) || isZoneStudent(zoneId));
        allow write: if isSignedIn() && (isZoneCreator(zoneId) || (isZoneStudent(zoneId) && request.auth.uid == studentId));
      }
    }

    match /zones/{zoneId}/attendance_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isZoneCreator(zoneId);
    }

    // ZONES/LEADERBOARD (Fix 2)
    match /zones/{zoneId}/leaderboard/{entryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }


    // --- CERTIFICATES Collection (Fix 1) ---
    // Rule: public read, no client writes. Using collection group match for platform-wide queries.
    match /{path=**}/certificates/{certId} {
      allow read: if true;
      allow write: if false;
    }

    // --- ISSUED CERTIFICATES Collection (Fix 1 follow-up) ---
    // Used in Classroom.tsx for student certificate queries
    match /{path=**}/issued_certificates/{certId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || 
        resource.data.tutorId == request.auth.uid
      );
      allow write: if false;
    }

    // --- OTPS Collection ---
    // Rule: deny all client reads and writes
    match /otps/{email} {
      allow read, write: if false;
    }

    // --- MAIL QUEUE Collection ---
    // Rule: explicit lock from client access. Read/Write allowed only via Admin SDK (Cloud Functions)
    match /mail_queue/{docId} {
      allow read, write: if false;
    }

    // --- PLATFORM ORDERS Collection ---
    // Rule: only the tutor who created the order can read it
    match /platform_orders/{orderId} {
      allow read: if isSignedIn() && resource.data.tutorId == request.auth.uid;
      allow write: if false;
    }

    // --- PRODUCTS Collection ---
    // Rule: public read, write for THALA role only if tutorId matches
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn() 
        && getUserData(request.auth.uid).role == 'THALA'
        && (request.method == 'delete' ? resource.data.tutorId == request.auth.uid : request.resource.data.tutorId == request.auth.uid);
    }
    // --- USERS Collection ---
    // Full profile read restricted to own user. Public reads limited to name, avatar, role.
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.resource == null
      );
      // Allow reading specific public fields for any authenticated user
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount']))
      );

      // Rule for the user's followers list (Fix: New Follower Mechanics)
      match /followers/{followerId} {
        // Anyone logged in can see who is following this user (allows count aggregations)
        allow read: if request.auth != null;
        
        // A user can ONLY add or remove themselves from another person's follower list
        allow write: if request.auth != null && request.auth.uid == followerId;
      }

      // Rule for the user's following list (Fix: New Follower Mechanics)
      match /following/{followingId} {
        // Anyone logged in can see who this user is following
        allow read: if request.auth != null;
        
        // A user can ONLY modify their own following list
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /enrollments/{enrollmentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /calendar_events/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /invoices/{invoiceId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null;
      }
    }

    // --- CONVERSATIONS Collection ---
    match /conversations/{conversationId} {
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        (resource.data.type == 'community' && resource.data.zoneId != null && (
          isZoneCreator(resource.data.zoneId) ||
          (isZoneStudent(resource.data.zoneId) && (
            resource.data.get('batchId', null) == getStudentBatchId(resource.data.zoneId)
          ))
        ))
      );
      allow create: if request.auth != null && (
        request.auth.uid in request.resource.data.participants
      );
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.participants && (
          !(resource.data.type == 'collaboration' && 
            request.resource.data.diff(resource.data).affectedKeys().hasAny(['name', 'description', 'avatar'])) ||
          resource.data.createdBy == request.auth.uid ||
          !('createdBy' in resource.data)
        )
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );
        allow create: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.resource.data.senderId == request.auth.uid
        );
      }
    }

    // --- ZONES/EXAM_RESULTS Collection ---
    match /zones/{zoneId}/exam_results/{resultId} {
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        isZoneCreator(zoneId)
      );
      allow write: if request.auth != null && (
        isZoneCreator(zoneId)
      );
    }

    // --- WHITEBOARDS Collection ---
    // Tutor (zone creator) can write; enrolled students can read live state.
    match /whiteboards/{zoneId} {
      allow read: if isSignedIn() && (
        isZoneCreator(zoneId) ||
        exists(/databases/$(database)/documents/zones/$(zoneId)/students/$(request.auth.uid))
      );
      allow write: if isSignedIn() && isZoneCreator(zoneId);
    }
  }
}
